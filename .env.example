# Copy to `.env.local` and fill in. Never commit the filled-in file (.gitignore excludes it).
# On Fly.io these are set with `fly secrets set` instead (see README).

# --- LiveKit (required) -------------------------------------------------------
# LiveKit Cloud dashboard: Settings -> API keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Database (optional) ------------------------------------------------------
# Defaults to a SQLite file, records.db, in the project folder.
# INTAKE_DB_URL=sqlite:////data/records.db
